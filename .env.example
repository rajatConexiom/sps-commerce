# Conexiom API credentials
CONEXIOM_TOKEN=your-bearer-token-here

# Conexiom project UUID
CONEXIOM_PROJECT_UUID=your-project-uuid-here

# Conexiom API endpoint (production)
CONEXIOM_API_URL=https://api.conexiom.com/api/v1/projects/{uuid}/documents/extraction

# Optional: override the folder containing order subfolders (.xerp + PDF)
# SPS_DOCS_DIR=C:\path\to\orders
